@startuml agribot_socket

namespace agribot_socket {
  interface IParsingStrategy
  {
    + {abstract} getUint8(std::uint8_t* buffer) : std::uint8_t
    + {abstract} getUint16(std::uint8_t* buffer) : std::uint16_t
    + {abstract} getUint32(std::uint8_t* buffer) : std::uint32_t
    + {abstract} getUint64(std::uint8_t* buffer) : std::uint64_t
    + {abstract} getFloat(std::uint8_t* buffer) : float
    + {abstract} getDouble(std::uint8_t* buffer) : double
  }

  class LsbFirstParsingStrategy
  {
    + getUint8(std::uint8_t* buffer) : std::uint8_t
    + getUint16(std::uint8_t* buffer) : std::uint16_t
    + getUint32(std::uint8_t* buffer) : std::uint32_t
    + getUint64(std::uint8_t* buffer) : std::uint64_t
    + getFloat(std::uint8_t* buffer) : float
    + getDouble(std::uint8_t* buffer) : double
  }

  class MsbFirstParsingStrategy
  {
    + getUint8(std::uint8_t* buffer) : std::uint8_t
    + getUint16(std::uint8_t* buffer) : std::uint16_t
    + getUint32(std::uint8_t* buffer) : std::uint32_t
    + getUint64(std::uint8_t* buffer) : std::uint64_t
    + getFloat(std::uint8_t* buffer) : float
    + getDouble(std::uint8_t* buffer) : double
  }

  class LsbFirstParsingStrategy implements IParsingStrategy
  class MsbFirstParsingStrategy implements IParsingStrategy


  interface IBuffer
  {
    - std::uint8_t* buffer_
    - std::size_t buffer_length_
    - std::size_t buffer_max_size_
  }

  interface IFrame
  {
    + parse() : void
  }

  interface ISocket
  {

  }

  interface IParser
  {

  }

}

@enduml